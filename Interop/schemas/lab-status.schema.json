{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/entertrainment/swift-cborld/blob/main/Interop/schemas/lab-status.schema.json",
  "title": "Swift-CBORLD Interop Lab status",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "updatedAt", "implementations"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "updatedAt": { "type": "string", "format": "date" },
    "implementations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "role", "url", "claims"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "claims": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["classification", "scope", "evidence"],
              "properties": {
                "classification": {
                  "enum": [
                    "source-present",
                    "build-validated",
                    "runtime-validated",
                    "hardware-executed",
                    "byte-identical",
                    "semantically-equivalent",
                    "performance-win",
                    "performance-wash",
                    "performance-loss",
                    "unavailable"
                  ]
                },
                "scope": { "type": "string", "minLength": 1 },
                "evidence": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
